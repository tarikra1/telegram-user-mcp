# Obtain API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_32_character_telegram_api_hash
TELEGRAM_PHONE=+15550109999

# Set to true to block send/edit/forward/delete/pin tools while allowing all read & search tools
TELEGRAM_READ_ONLY=false

# Optional client identification
TELEGRAM_DEVICE_MODEL="Telegram User MCP"
TELEGRAM_SYSTEM_VERSION="Desktop"
